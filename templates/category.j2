<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ seo_title }}</title>
  <meta name="description" content="{{ seo_desc }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ base_url }}/category/{{ cat_slug }}">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ seo_title }}">
  <meta property="og:description" content="{{ seo_desc }}">
  <meta property="og:url" content="{{ base_url }}/category/{{ cat_slug }}">
  <meta property="og:site_name" content="AI Nav">
  <meta property="og:image" content="{{ base_url }}/og-cover.png">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo_title }}">
  <meta name="twitter:description" content="{{ seo_desc }}">
  <meta name="twitter:image" content="{{ base_url }}/og-cover.png">

  <!-- Schema.org: ItemList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ seo_title | tojson }},
    "url": "{{ base_url }}/category/{{ cat_slug }}",
    "description": {{ seo_desc | tojson }},
    "numberOfItems": {{ tools | length }},
    "itemListElement": [
      {% for tool in tools[:20] %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "name": {{ tool.name | tojson }},
        "url": "{{ base_url }}/tools/{{ tool_filenames[tool.id] }}",
        "description": {{ tool.descEn[:100] | tojson }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>

  <!-- Schema.org: BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ base_url }}/" },
      { "@type": "ListItem", "position": 2, "name": {{ (cat.label + "s") | tojson }}, "item": "{{ base_url }}/category/{{ cat_slug }}" }
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../assets/shared.css">
  <!-- Microsoft Clarity -->
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","wpx75a9uax");
  </script>
</head>
<body>

<!-- Header -->
<header>
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="logo-icon">⚡</span>
      <span>AI<span class="logo-accent">.</span>Nav</span>
    </a>
    <div class="header-spacer"></div>
    <a href="/" class="nav-home">← All Tools</a>
    <a href="https://game.yuzec.com" target="_blank" rel="noopener" style="font-weight:500;font-size:14px;color:var(--text-2);text-decoration:none;margin-left:12px;padding:4px 10px;border-radius:6px;border:1px solid var(--border);white-space:nowrap">🎮 小游戏</a>
    <a href="https://github.com/yuzechang/AI_Guide" target="_blank" rel="noopener" class="gh-link" aria-label="GitHub">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836a9.59 9.59 0 012.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/></svg>
    </a>
  </div>
</header>

<!-- Breadcrumb -->
<div class="breadcrumb">
  <a href="/">Home</a>
  <span class="breadcrumb-sep">›</span>
  <span class="breadcrumb-cur">{{ cat.label }}s</span>
</div>

<!-- Hero -->
<div class="page-hero" style="margin-top:16px">
  <div class="page-hero-inner">
    <span class="article-badge" style="background:{{ cat.color | replace('#','rgba(') }}1a);border-color:{{ cat.color | replace('#','rgba(') }}40);color:{{ cat.color }}">
      {{ cat.icon }} {{ cat.label }}s
    </span>
    <h1 class="article-title" style="margin-top:12px">{{ h1 }}</h1>
    <p class="article-desc">{{ intro }}</p>
    <div class="hero-stats" style="margin-top:20px">
      <div class="stat">
        <div class="stat-dot" style="background:{{ cat.color }}"></div>
        <span class="stat-num">{{ tools | length }}</span>
        <span>{{ cat.label }}s Listed</span>
      </div>
      <div class="stat">
        <div class="stat-dot" style="background:var(--accent)"></div>
        <span class="stat-num">{{ total_stars_label }}</span>
        <span>Total GitHub Stars</span>
      </div>
      <div class="stat">
        <div class="stat-dot" style="background:#34d399"></div>
        <span class="stat-num">100%</span>
        <span>Open Source</span>
      </div>
    </div>
  </div>
</div>

<!-- Tool List -->
<div class="page-wrap">
  <div class="content">

    <p style="color:var(--text-3);font-size:13px;margin-bottom:24px">
      Showing {{ tools | length }} {{ cat.label | lower }}s sorted by GitHub stars — all open-source with proven community adoption.
    </p>

    <div class="category-tool-list">
      {% for tool in tools %}
      {% set tfile = tool_filenames[tool.id] %}
      <a href="../tools/{{ tfile }}" class="category-tool-card">
        <div class="ctc-rank">#{{ loop.index }}</div>
        <div class="ctc-body">
          <div class="ctc-header">
            <span class="ctc-name">{{ tool.name }}</span>
            <span class="stars-badge">★ {{ tool.starsLabel }}</span>
            {% if tool.featured %}<span class="tag-chip" style="background:rgba(251,191,36,.1);color:#fbbf24;border-color:rgba(251,191,36,.3)">Featured</span>{% endif %}
          </div>
          <p class="ctc-desc">{{ tool.descEn[:140] }}{% if tool.descEn | length > 140 %}…{% endif %}</p>
          <div class="ctc-tags">
            {% for tag in tool.tags[:4] %}
            <span class="tag-chip">{{ tag }}</span>
            {% endfor %}
            {% if tool.license %}<span class="tag-chip" style="background:rgba(52,211,153,.1);color:#34d399;border-color:rgba(52,211,153,.3)">{{ tool.license }}</span>{% endif %}
          </div>
        </div>
        <span class="ctc-arrow">→</span>
      </a>
      {% endfor %}
    </div>

    <div class="alert alert-info" style="margin-top:40px">
      💡 <strong>Missing a tool?</strong>
      Open an issue on our <a href="https://github.com/yuzechang/AI_Guide" target="_blank" rel="noopener">GitHub repository</a>
      to suggest a new {{ cat.label | lower }} for inclusion. We review submissions weekly.
    </div>

  </div>
</div>

<!-- Footer -->
<footer>
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo"><span class="logo-icon">⚡</span><span>AI<span class="logo-accent">.</span>Nav</span></div>
        <p>A curated directory of 300+ open-source AI tools, agent frameworks, and skill libraries from GitHub.</p>
      </div>
      <div class="footer-col">
        <h4>Categories</h4>
        <ul>
          <li><a href="ai-tools">AI Tools</a></li>
          <li><a href="skill">Skill Frameworks</a></li>
          <li><a href="agent">AI Agents</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Site</h4>
        <ul>
          <li><a href="../about">About</a></li>
          <li><a href="../contact">Contact</a></li>
          <li><a href="../privacy-policy">Privacy Policy</a></li>
          <li><a href="../sitemap.xml">Sitemap</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Resources</h4>
        <ul>
          <li><a href="https://github.com/trending" target="_blank" rel="noopener">GitHub Trending</a></li>
          <li><a href="https://github.com/Hannibal046/Awesome-LLM" target="_blank" rel="noopener">Awesome LLM</a></li>
          <li><a href="https://github.com/e2b-dev/awesome-ai-agents" target="_blank" rel="noopener">Awesome Agents</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 AI Nav · All tools are open-source, hosted on GitHub.</p>
      <p>Built for the AI community ❤️</p>
    </div>
  </div>
</footer>

</body>
</html>
