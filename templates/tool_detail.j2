<!DOCTYPE html>
<html lang="en" data-lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ seo_title }}</title>
  <meta name="description" content="{{ seo_desc }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ base_url }}/tools/{{ tool.id }}.html">

  <!-- Open Graph -->
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ seo_title }}">
  <meta property="og:description" content="{{ seo_desc }}">
  <meta property="og:url" content="{{ base_url }}/tools/{{ tool.id }}.html">
  <meta property="og:site_name" content="AI Nav">

  <!-- Schema.org: SoftwareApplication -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": {{ tool.name | tojson }},
    "applicationCategory": {{ cat.app_category | tojson }},
    "operatingSystem": "Windows, macOS, Linux",
    "url": {{ tool.githubUrl | tojson }},
    "description": {{ tool.descEn | tojson }},
    "offers": [{ "@type": "Offer", "price": "0", "priceCurrency": "USD", "name": {{ (tool.license or "Open Source") | tojson }} }]
  }
  </script>

  <!-- Schema.org: BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ base_url }}/" },
      { "@type": "ListItem", "position": 2, "name": {{ cat.label | tojson }}, "item": "{{ base_url }}/#{{ tool.category }}" },
      { "@type": "ListItem", "position": 3, "name": {{ tool.name | tojson }}, "item": "{{ base_url }}/tools/{{ tool.id }}.html" }
    ]
  }
  </script>

  <!-- Schema.org: FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% set faq_list = tool.faqs if tool.faqs else faqs %}
      {% for faq in faq_list %}
      {
        "@type": "Question",
        "name": {{ faq.q | tojson }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ faq.a | tojson }} }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../assets/shared.css">
</head>
<body>

<!-- Header -->
<header>
  <div class="header-inner">
    <a href="../index.html" class="logo">
      <span class="logo-icon">⚡</span>
      <span>AI<span class="logo-accent">.</span>Nav</span>
    </a>
    <div class="header-spacer"></div>
    <a href="../index.html" class="nav-home">
      <span class="en">← All Tools</span>
      <span class="zh">← 全部工具</span>
    </a>
    <div class="lang-toggle" style="margin-left:8px">
      <button class="lang-btn active" id="btn-en" onclick="setLang('en')">EN</button>
      <button class="lang-btn" id="btn-zh" onclick="setLang('zh')">中</button>
    </div>
  </div>
</header>

<!-- Breadcrumb -->
<div class="breadcrumb">
  <a href="../index.html"><span class="en">Home</span><span class="zh">首页</span></a>
  <span class="breadcrumb-sep">›</span>
  <a href="../index.html#{{ tool.category }}">
    <span class="en">{{ cat.label }}</span>
    <span class="zh">{{ cat.labelCn }}</span>
  </a>
  <span class="breadcrumb-sep">›</span>
  <span class="breadcrumb-cur">{{ tool.name }}</span>
</div>

<!-- Hero -->
<div class="page-hero" style="margin-top:16px">
  <div class="page-hero-inner">
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px">
      <span class="article-badge" style="background:{{ cat.color | replace('#','rgba(') }}1a);border-color:{{ cat.color | replace('#','rgba(') }}40);color:{{ cat.color }}">
        {{ cat.icon }}
        <span class="en">{{ cat.label }}</span>
        <span class="zh">{{ cat.labelCn }}</span>
      </span>
      <span class="stars-badge">★ {{ tool.starsLabel }} GitHub Stars</span>
      {% for tag in tool.tags[:3] %}
      <span class="tag-chip">{{ tag }}</span>
      {% endfor %}
    </div>
    <h1 class="article-title">
      <span class="gradient">{{ tool.name }}</span>
      {% if tool.nameCn and tool.nameCn != tool.name %} – {{ tool.nameCn }}{% endif %}
    </h1>
    <p class="article-desc">{{ tool.descEn }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:20px">
      <a href="{{ tool.githubUrl }}" target="_blank" rel="noopener" class="cta-btn">
        <span class="en">View on GitHub ↗</span>
        <span class="zh">在 GitHub 查看 ↗</span>
      </a>
      {% if tool.affiliateUrl %}
      <a href="{{ tool.affiliateUrl }}" target="_blank" rel="nofollow noopener sponsored" class="cta-btn-outline">
        Try {{ tool.name }} Free ↗
      </a>
      {% elif tool.website %}
      <a href="{{ tool.website }}" target="_blank" rel="noopener" class="cta-btn-outline">
        <span class="en">Official Website ↗</span>
        <span class="zh">官方网站 ↗</span>
      </a>
      {% endif %}
    </div>
  </div>
</div>

<!-- Content -->
<div class="page-wrap-wide">
  <div class="content-layout">
    <article class="content">

      <!-- Quick Facts Grid -->
      <div class="info-grid">
        <div class="info-card">
          <div class="info-card-label"><span class="en">Category</span><span class="zh">分类</span></div>
          <div class="info-card-value">
            <span class="en">{{ cat.label }}</span>
            <span class="zh">{{ cat.labelCn }}</span>
          </div>
          <div class="info-card-sub">{{ tool.category }}</div>
        </div>
        <div class="info-card">
          <div class="info-card-label"><span class="en">GitHub Stars</span><span class="zh">GitHub 星数</span></div>
          <div class="info-card-value">{{ tool.starsLabel }}</div>
          <div class="info-card-sub"><span class="en">Community adoption</span><span class="zh">社区认可度</span></div>
        </div>
        <div class="info-card">
          <div class="info-card-label"><span class="en">License</span><span class="zh">许可证</span></div>
          <div class="info-card-value">{{ tool.license or "Open Source" }}</div>
          <div class="info-card-sub">
            <span class="en">{{ "Free to use" if not tool.license else "Check repository" }}</span>
            <span class="zh">{{ "免费使用" if not tool.license else "查看仓库" }}</span>
          </div>
        </div>
        <div class="info-card">
          <div class="info-card-label"><span class="en">Tags</span><span class="zh">标签</span></div>
          <div class="info-card-value" style="font-size:13px">{{ tool.tags[:3] | join(", ") }}</div>
          <div class="info-card-sub">{{ tool.tags | length }} <span class="en">tags total</span><span class="zh">个标签</span></div>
        </div>
      </div>

      <!-- What is {name}? -->
      <h2 id="what-is">
        <span class="en">What Is {{ tool.name }}?</span>
        <span class="zh">{{ tool.name }} 是什么？</span>
      </h2>
      <p>
        <strong>{{ tool.name }}</strong> is an open-source {{ cat.type }} with
        {{ tool.starsLabel }} GitHub stars. {{ tool.descEn }}
      </p>
      <p>
        As a {{ cat.type }}, {{ tool.name }} is designed to help developers and teams
        {% if tool.category == "ai-tools" %}
        integrate AI capabilities into their projects without building everything from scratch.
        It provides a ready-to-use interface that reduces the time from idea to working prototype.
        {% elif tool.category == "skill" %}
        build production-ready AI applications with reliable, tested abstractions.
        It handles the complexity of connecting LLMs to external data and tools,
        so engineers can focus on business logic instead of plumbing.
        {% else %}
        automate complex tasks by combining planning, tool use, and iterative execution.
        Instead of following a fixed script, it dynamically adapts its approach
        based on intermediate results and feedback.
        {% endif %}
      </p>
      <p>
        The project is maintained on GitHub at
        <a href="{{ tool.githubUrl }}" target="_blank" rel="noopener">{{ tool.githubUrl | replace("https://github.com/", "github.com/") }}</a>
        and is actively developed with a strong open-source community.
        {% if tool.stars >= 10000 %}
        With {{ tool.starsLabel }} stars, it is one of the most widely adopted tools in its category.
        {% elif tool.stars >= 5000 %}
        Its {{ tool.starsLabel }} GitHub stars reflect significant community validation and adoption.
        {% else %}
        The growing community contributes bug fixes, new features, and documentation improvements regularly.
        {% endif %}
      </p>

      <!-- Features -->
      {% if features %}
      <h2 id="features">
        <span class="en">Key Features</span>
        <span class="zh">核心功能</span>
      </h2>
      <ul class="feature-list">
        {% for feat in features %}
        <li>
          <span class="feat-icon">{{ feat.icon }}</span>
          <div><strong>{{ feat.title }}</strong> — {{ feat.desc }}</div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}

      <!-- Pros & Cons -->
      {% if tool.pros or tool.cons %}
      <h2 id="pros-cons">
        <span class="en">Pros &amp; Cons</span>
        <span class="zh">优缺点</span>
      </h2>
      <div class="pros-cons">
        {% if tool.pros %}
        <div class="pros-box">
          <h4>✓ <span class="en">Pros</span><span class="zh">优点</span></h4>
          <ul>
            {% for p in tool.pros %}
            <li>{{ p }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        {% if tool.cons %}
        <div class="cons-box">
          <h4>✕ <span class="en">Cons</span><span class="zh">缺点</span></h4>
          <ul>
            {% for c in tool.cons %}
            <li>{{ c }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>
      {% endif %}

      <!-- Use Cases -->
      <h2 id="use-cases">
        <span class="en">Use Cases</span>
        <span class="zh">应用场景</span>
      </h2>
      <p>
        {{ tool.name }} is used across a wide range of applications in the AI development ecosystem.
        Here are the most common scenarios where teams choose {{ tool.name }}:
      </p>
      {% for uc in cat.use_cases %}
      <h3>{{ uc.icon }} {{ uc.title }}</h3>
      <p>{{ uc.desc }}</p>
      {% endfor %}

      <!-- Getting Started -->
      <h2 id="getting-started">
        <span class="en">Getting Started with {{ tool.name }}</span>
        <span class="zh">{{ tool.name }} 快速开始</span>
      </h2>
      <p>
        To get started with {{ tool.name }}, visit the
        <a href="{{ tool.githubUrl }}" target="_blank" rel="noopener">GitHub repository</a>
        and follow the installation instructions in the README.
        {% if tool.category == "skill" %}
        Most Python frameworks can be installed via pip:
        <code>pip install {{ tool.id }}</code>
        {% elif tool.category == "ai-tools" %}
        Many AI tools provide Docker images for quick deployment:
        check the repository for the latest <code>docker-compose.yml</code> or installer script.
        {% else %}
        Agent frameworks typically require an API key for the LLM backend
        (OpenAI, Anthropic, or a local model via Ollama).
        {% endif %}
      </p>
      <div class="alert alert-info">
        💡 <strong>Tip:</strong> Check the GitHub repository's
        <a href="{{ tool.githubUrl }}/issues" target="_blank" rel="noopener">Issues</a> and
        <a href="{{ tool.githubUrl }}/discussions" target="_blank" rel="noopener">Discussions</a>
        pages for community support, and the
        <a href="{{ tool.githubUrl }}/releases" target="_blank" rel="noopener">Releases</a>
        page for the latest stable version.
      </div>

      <!-- Affiliate / Official Site CTA -->
      {% if tool.affiliateUrl or tool.website %}
      {% set cta_url = tool.affiliateUrl if tool.affiliateUrl else tool.website %}
      {% set cta_rel = "nofollow noopener sponsored" if tool.affiliateUrl else "noopener" %}
      {% set cta_text_en = "Try " + tool.name + " Free" if tool.affiliateUrl else "Visit Official Site" %}
      {% set cta_text_zh = "免费试用 " + tool.name if tool.affiliateUrl else "访问官方网站" %}
      <div class="affiliate-cta">
        <div class="affiliate-cta-left">
          <div class="affiliate-cta-title">
            <span class="en">Get Started with {{ tool.name }}</span>
            <span class="zh">立即开始使用 {{ tool.name }}</span>
          </div>
          <div class="affiliate-cta-desc">
            <span class="en">Visit the official site for documentation, downloads, and cloud plans.</span>
            <span class="zh">访问官方网站获取文档、下载和云端方案。</span>
          </div>
        </div>
        <a href="{{ cta_url }}" target="_blank" rel="{{ cta_rel }}" class="cta-btn affiliate-cta-btn">
          <span class="en">{{ cta_text_en }} ↗</span>
          <span class="zh">{{ cta_text_zh }} ↗</span>
        </a>
      </div>
      {% if tool.affiliateUrl %}
      <p class="affiliate-disclosure">
        Disclosure: The link above is an affiliate link. If you sign up or purchase, we may earn a commission at no extra cost to you. This helps support AI Nav's operations. We only link to tools we genuinely recommend.
      </p>
      {% endif %}
      {% endif %}

      <!-- Related Tools -->
      {% if related %}
      <h2 id="alternatives">
        <span class="en">Similar {{ cat.label }}s</span>
        <span class="zh">相似 {{ cat.labelCn }}</span>
      </h2>
      <p>
        If {{ tool.name }} doesn't fit your needs, here are other popular
        {{ cat.label }}s you might consider:
      </p>
      <div class="related-grid">
        {% for r in related %}
        <a href="{{ r.id }}.html" class="related-card">
          <div class="related-card-name">{{ r.name }}</div>
          <div class="related-card-desc">{{ r.descEn[:80] }}{% if r.descEn | length > 80 %}…{% endif %}</div>
        </a>
        {% endfor %}
      </div>
      {% endif %}

      <!-- FAQ -->
      <h2 id="faq">
        <span class="en">Frequently Asked Questions</span>
        <span class="zh">常见问题</span>
      </h2>
      <div class="faq-section">
        {% if tool.faqs %}
          {% for faq in tool.faqs %}
          <div class="faq-item">
            <div class="faq-q" onclick="faqToggle(this)">
              {{ faq.q }} <span class="faq-arr">▼</span>
            </div>
            <div class="faq-a">
              <div class="faq-a-inner">{{ faq.a }}</div>
            </div>
          </div>
          {% endfor %}
        {% else %}
          {% for faq in faqs %}
          <div class="faq-item">
            <div class="faq-q" onclick="faqToggle(this)">
              {{ faq.q }} <span class="faq-arr">▼</span>
            </div>
            <div class="faq-a">
              <div class="faq-a-inner">{{ faq.a }}</div>
            </div>
          </div>
          {% endfor %}
        {% endif %}
      </div>

    </article>

    <!-- Sidebar -->
    <aside class="content-sidebar">
      <div class="sidebar-card">
        <h4><span class="en">Quick Facts</span><span class="zh">快速概览</span></h4>
        <div style="font-size:13px;color:var(--text-2)">
          <div style="margin-bottom:8px">
            <span style="color:var(--text-3)">GitHub:</span>
            <a href="{{ tool.githubUrl }}" target="_blank" rel="noopener" style="color:var(--accent)">
              {{ tool.githubUrl | replace("https://github.com/","") }}
            </a>
          </div>
          <div style="margin-bottom:8px"><span style="color:var(--text-3)"><span class="en">Stars:</span><span class="zh">星数：</span></span> {{ tool.starsLabel }}</div>
          <div style="margin-bottom:8px">
            <span style="color:var(--text-3)"><span class="en">Category:</span><span class="zh">分类：</span></span>
            <span class="en">{{ cat.label }}</span><span class="zh">{{ cat.labelCn }}</span>
          </div>
          <div style="margin-bottom:8px"><span style="color:var(--text-3)"><span class="en">License:</span><span class="zh">许可证：</span></span> {{ tool.license or "Open Source" }}</div>
          {% if tool.website %}
          <div style="margin-bottom:8px">
            <span style="color:var(--text-3)"><span class="en">Website:</span><span class="zh">网站：</span></span>
            <a href="{{ tool.website }}" target="_blank" rel="noopener" style="color:var(--accent)">
              <span class="en">Official Site ↗</span><span class="zh">官方网站 ↗</span>
            </a>
          </div>
          {% endif %}
          <div><span style="color:var(--text-3)"><span class="en">Updated:</span><span class="zh">更新：</span></span> {{ today }}</div>
        </div>
      </div>

      <div class="sidebar-card">
        <h4><span class="en">Table of Contents</span><span class="zh">目录</span></h4>
        <ul class="toc-list">
          <li><a href="#what-is"><span class="en">What Is {{ tool.name }}?</span><span class="zh">{{ tool.name }} 是什么？</span></a></li>
          {% if features %}<li><a href="#features"><span class="en">Key Features</span><span class="zh">核心功能</span></a></li>{% endif %}
          {% if tool.pros or tool.cons %}<li><a href="#pros-cons"><span class="en">Pros &amp; Cons</span><span class="zh">优缺点</span></a></li>{% endif %}
          <li><a href="#use-cases"><span class="en">Use Cases</span><span class="zh">应用场景</span></a></li>
          <li><a href="#getting-started"><span class="en">Getting Started</span><span class="zh">快速开始</span></a></li>
          {% if related %}<li><a href="#alternatives"><span class="en">Alternatives</span><span class="zh">替代工具</span></a></li>{% endif %}
          <li><a href="#faq"><span class="en">FAQ</span><span class="zh">常见问题</span></a></li>
        </ul>
      </div>

      {% if related %}
      <div class="sidebar-card">
        <h4><span class="en">Related Tools</span><span class="zh">相关工具</span></h4>
        <ul class="toc-list">
          {% for r in related[:5] %}
          <li><a href="{{ r.id }}.html">{{ r.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      <div class="sidebar-card">
        <h4><span class="en">Tags</span><span class="zh">标签</span></h4>
        <div style="display:flex;flex-wrap:wrap;gap:4px">
          {% for tag in tool.tags %}
          <span class="tag-chip">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
    </aside>
  </div>
</div>

<!-- Footer -->
<footer>
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo"><span class="logo-icon">⚡</span><span>AI<span class="logo-accent">.</span>Nav</span></div>
        <p>
          <span class="en">A curated directory of 300+ open-source AI tools, agent frameworks, and skill libraries.</span>
          <span class="zh">精选 300+ 开源 AI 工具、智能体框架与技能库目录。</span>
        </p>
      </div>
      <div class="footer-col">
        <h4><span class="en">Categories</span><span class="zh">分类</span></h4>
        <ul>
          <li><a href="../index.html#ai-tools"><span class="en">AI Tools</span><span class="zh">AI 工具</span></a></li>
          <li><a href="../index.html#skill"><span class="en">Skill Frameworks</span><span class="zh">技能框架</span></a></li>
          <li><a href="../index.html#agent"><span class="en">AI Agents</span><span class="zh">AI 智能体</span></a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4><span class="en">Site</span><span class="zh">站点</span></h4>
        <ul>
          <li><a href="../about.html"><span class="en">About</span><span class="zh">关于</span></a></li>
          <li><a href="../contact.html"><span class="en">Contact</span><span class="zh">联系</span></a></li>
          <li><a href="../privacy-policy.html"><span class="en">Privacy Policy</span><span class="zh">隐私政策</span></a></li>
          <li><a href="../sitemap.xml">Sitemap</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4><span class="en">Featured</span><span class="zh">精选工具</span></h4>
        <ul>
          <li><a href="cursor.html">Cursor AI</a></li>
          <li><a href="claude-code.html">Claude Code</a></li>
          <li><a href="chatgpt.html">ChatGPT</a></li>
          <li><a href="ollama.html">Ollama</a></li>
          <li><a href="langchain.html">LangChain</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2025 AI Nav · <span class="en">All tools are open-source, hosted on GitHub.</span><span class="zh">所有工具均为开源项目，托管于 GitHub。</span></p>
      <p><span class="en">Built for the AI community</span><span class="zh">为 AI 社区而建</span> ❤️</p>
    </div>
  </div>
</footer>

<script>
function faqToggle(el) { el.closest('.faq-item').classList.toggle('open'); }

function setLang(lang) {
  document.documentElement.setAttribute('data-lang', lang);
  localStorage.setItem('ai-nav-lang', lang);
  document.getElementById('btn-en').classList.toggle('active', lang === 'en');
  document.getElementById('btn-zh').classList.toggle('active', lang === 'zh');
}

(function initLang() {
  var saved = localStorage.getItem('ai-nav-lang');
  if (saved === 'zh') setLang('zh');
})();
</script>
</body>
</html>
