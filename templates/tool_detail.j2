<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ seo_title }}</title>
  <meta name="description" content="{{ seo_desc }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ base_url }}/tools/{{ tool.id }}.html">

  <!-- Open Graph -->
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ seo_title }}">
  <meta property="og:description" content="{{ seo_desc }}">
  <meta property="og:url" content="{{ base_url }}/tools/{{ tool.id }}.html">
  <meta property="og:site_name" content="AI Nav">

  <!-- Schema.org: SoftwareApplication -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": {{ tool.name | tojson }},
    "applicationCategory": {{ cat.app_category | tojson }},
    "operatingSystem": "Windows, macOS, Linux",
    "url": {{ tool.githubUrl | tojson }},
    "description": {{ tool.descEn | tojson }},
    "offers": [{ "@type": "Offer", "price": "0", "priceCurrency": "USD", "name": {{ (tool.license or "Open Source") | tojson }} }]
  }
  </script>

  <!-- Schema.org: BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ base_url }}/" },
      { "@type": "ListItem", "position": 2, "name": {{ cat.label | tojson }}, "item": "{{ base_url }}/#{{ tool.category }}" },
      { "@type": "ListItem", "position": 3, "name": {{ tool.name | tojson }}, "item": "{{ base_url }}/tools/{{ tool.id }}.html" }
    ]
  }
  </script>

  <!-- Schema.org: FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in faqs %}
      {
        "@type": "Question",
        "name": {{ faq.q | tojson }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ faq.a | tojson }} }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../assets/shared.css">
</head>
<body>

<!-- Header -->
<header>
  <div class="header-inner">
    <a href="../index.html" class="logo">
      <span class="logo-icon">⚡</span>
      <span>AI<span class="logo-accent">.</span>Nav</span>
    </a>
    <div class="header-spacer"></div>
    <a href="../index.html" class="nav-home">← All Tools</a>
  </div>
</header>

<!-- Breadcrumb -->
<div class="breadcrumb">
  <a href="../index.html">Home</a>
  <span class="breadcrumb-sep">›</span>
  <a href="../index.html#{{ tool.category }}">{{ cat.label }}</a>
  <span class="breadcrumb-sep">›</span>
  <span class="breadcrumb-cur">{{ tool.name }}</span>
</div>

<!-- Hero -->
<div class="page-hero" style="margin-top:16px">
  <div class="page-hero-inner">
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px">
      <span class="article-badge" style="background:{{ cat.color | replace('#','rgba(') }}1a);border-color:{{ cat.color | replace('#','rgba(') }}40);color:{{ cat.color }}">
        {{ cat.icon }} {{ cat.label }}
      </span>
      <span class="stars-badge">★ {{ tool.starsLabel }} GitHub Stars</span>
      {% for tag in tool.tags[:3] %}
      <span class="tag-chip">{{ tag }}</span>
      {% endfor %}
    </div>
    <h1 class="article-title">
      <span class="gradient">{{ tool.name }}</span>
      {% if tool.nameCn and tool.nameCn != tool.name %} – {{ tool.nameCn }}{% endif %}
    </h1>
    <p class="article-desc">{{ tool.descEn }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:20px">
      <a href="{{ tool.githubUrl }}" target="_blank" rel="noopener" class="cta-btn">
        View on GitHub ↗
      </a>
      {% if tool.website %}
      <a href="{{ tool.website }}" target="_blank" rel="noopener" class="cta-btn-outline">
        Official Website ↗
      </a>
      {% endif %}
    </div>
  </div>
</div>

<!-- Content -->
<div class="page-wrap-wide">
  <div class="content-layout">
    <article class="content">

      <!-- Quick Facts Grid -->
      <div class="info-grid">
        <div class="info-card">
          <div class="info-card-label">Category</div>
          <div class="info-card-value">{{ cat.label }}</div>
          <div class="info-card-sub">{{ tool.category }}</div>
        </div>
        <div class="info-card">
          <div class="info-card-label">GitHub Stars</div>
          <div class="info-card-value">{{ tool.starsLabel }}</div>
          <div class="info-card-sub">Community adoption</div>
        </div>
        <div class="info-card">
          <div class="info-card-label">License</div>
          <div class="info-card-value">{{ tool.license or "Open Source" }}</div>
          <div class="info-card-sub">{{ "Free to use" if not tool.license else "Check repository" }}</div>
        </div>
        <div class="info-card">
          <div class="info-card-label">Tags</div>
          <div class="info-card-value" style="font-size:13px">{{ tool.tags[:3] | join(", ") }}</div>
          <div class="info-card-sub">{{ tool.tags | length }} tags total</div>
        </div>
      </div>

      <!-- What is {name}? -->
      <h2 id="what-is">What Is {{ tool.name }}?</h2>
      <p>
        <strong>{{ tool.name }}</strong> is an open-source {{ cat.type }} with
        {{ tool.starsLabel }} GitHub stars. {{ tool.descEn }}
      </p>
      <p>
        As a {{ cat.type }}, {{ tool.name }} is designed to help developers and teams
        {% if tool.category == "ai-tools" %}
        integrate AI capabilities into their projects without building everything from scratch.
        It provides a ready-to-use interface that reduces the time from idea to working prototype.
        {% elif tool.category == "skill" %}
        build production-ready AI applications with reliable, tested abstractions.
        It handles the complexity of connecting LLMs to external data and tools,
        so engineers can focus on business logic instead of plumbing.
        {% else %}
        automate complex tasks by combining planning, tool use, and iterative execution.
        Instead of following a fixed script, it dynamically adapts its approach
        based on intermediate results and feedback.
        {% endif %}
      </p>
      <p>
        The project is maintained on GitHub at
        <a href="{{ tool.githubUrl }}" target="_blank" rel="noopener">{{ tool.githubUrl | replace("https://github.com/", "github.com/") }}</a>
        and is actively developed with a strong open-source community.
        {% if tool.stars >= 10000 %}
        With {{ tool.starsLabel }} stars, it is one of the most widely adopted tools in its category.
        {% elif tool.stars >= 5000 %}
        Its {{ tool.starsLabel }} GitHub stars reflect significant community validation and adoption.
        {% else %}
        The growing community contributes bug fixes, new features, and documentation improvements regularly.
        {% endif %}
      </p>

      <!-- Features -->
      {% if features %}
      <h2 id="features">Key Features</h2>
      <ul class="feature-list">
        {% for feat in features %}
        <li>
          <span class="feat-icon">{{ feat.icon }}</span>
          <div><strong>{{ feat.title }}</strong> — {{ feat.desc }}</div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}

      <!-- Use Cases -->
      <h2 id="use-cases">Use Cases</h2>
      <p>
        {{ tool.name }} is used across a wide range of applications in the AI development ecosystem.
        Here are the most common scenarios where teams choose {{ tool.name }}:
      </p>
      {% for uc in cat.use_cases %}
      <h3>{{ uc.icon }} {{ uc.title }}</h3>
      <p>{{ uc.desc }}</p>
      {% endfor %}

      <!-- Getting Started -->
      <h2 id="getting-started">Getting Started with {{ tool.name }}</h2>
      <p>
        To get started with {{ tool.name }}, visit the
        <a href="{{ tool.githubUrl }}" target="_blank" rel="noopener">GitHub repository</a>
        and follow the installation instructions in the README.
        {% if tool.category == "skill" %}
        Most Python frameworks can be installed via pip:
        <code>pip install {{ tool.id }}</code>
        {% elif tool.category == "ai-tools" %}
        Many AI tools provide Docker images for quick deployment:
        check the repository for the latest <code>docker-compose.yml</code> or installer script.
        {% else %}
        Agent frameworks typically require an API key for the LLM backend
        (OpenAI, Anthropic, or a local model via Ollama).
        {% endif %}
      </p>
      <div class="alert alert-info">
        💡 <strong>Tip:</strong> Check the GitHub repository's
        <a href="{{ tool.githubUrl }}/issues" target="_blank" rel="noopener">Issues</a> and
        <a href="{{ tool.githubUrl }}/discussions" target="_blank" rel="noopener">Discussions</a>
        pages for community support, and the
        <a href="{{ tool.githubUrl }}/releases" target="_blank" rel="noopener">Releases</a>
        page for the latest stable version.
      </div>

      <!-- Related Tools -->
      {% if related %}
      <h2 id="alternatives">Similar {{ cat.label }}s</h2>
      <p>
        If {{ tool.name }} doesn't fit your needs, here are other popular
        {{ cat.label }}s you might consider:
      </p>
      <div class="related-grid">
        {% for r in related %}
        <a href="{{ r.id }}.html" class="related-card">
          <div class="related-card-name">{{ r.name }}</div>
          <div class="related-card-desc">{{ r.descEn[:80] }}{% if r.descEn | length > 80 %}…{% endif %}</div>
        </a>
        {% endfor %}
      </div>
      {% endif %}

      <!-- FAQ -->
      <h2 id="faq">Frequently Asked Questions</h2>
      <div class="faq-section">
        {% for faq in faqs %}
        <div class="faq-item">
          <div class="faq-q" onclick="faqToggle(this)">
            {{ faq.q }} <span class="faq-arr">▼</span>
          </div>
          <div class="faq-a">
            <div class="faq-a-inner">{{ faq.a }}</div>
          </div>
        </div>
        {% endfor %}
      </div>

    </article>

    <!-- Sidebar -->
    <aside class="content-sidebar">
      <div class="sidebar-card">
        <h4>Quick Facts</h4>
        <div style="font-size:13px;color:var(--text-2)">
          <div style="margin-bottom:8px">
            <span style="color:var(--text-3)">GitHub:</span>
            <a href="{{ tool.githubUrl }}" target="_blank" rel="noopener" style="color:var(--accent)">
              {{ tool.githubUrl | replace("https://github.com/","") }}
            </a>
          </div>
          <div style="margin-bottom:8px"><span style="color:var(--text-3)">Stars:</span> {{ tool.starsLabel }}</div>
          <div style="margin-bottom:8px"><span style="color:var(--text-3)">Category:</span> {{ cat.label }}</div>
          <div style="margin-bottom:8px"><span style="color:var(--text-3)">License:</span> {{ tool.license or "Open Source" }}</div>
          {% if tool.website %}
          <div style="margin-bottom:8px">
            <span style="color:var(--text-3)">Website:</span>
            <a href="{{ tool.website }}" target="_blank" rel="noopener" style="color:var(--accent)">Official Site ↗</a>
          </div>
          {% endif %}
          <div><span style="color:var(--text-3)">Updated:</span> {{ today }}</div>
        </div>
      </div>

      <div class="sidebar-card">
        <h4>Table of Contents</h4>
        <ul class="toc-list">
          <li><a href="#what-is">What Is {{ tool.name }}?</a></li>
          {% if features %}<li><a href="#features">Key Features</a></li>{% endif %}
          <li><a href="#use-cases">Use Cases</a></li>
          <li><a href="#getting-started">Getting Started</a></li>
          {% if related %}<li><a href="#alternatives">Alternatives</a></li>{% endif %}
          <li><a href="#faq">FAQ</a></li>
        </ul>
      </div>

      {% if related %}
      <div class="sidebar-card">
        <h4>Related Tools</h4>
        <ul class="toc-list">
          {% for r in related[:5] %}
          <li><a href="{{ r.id }}.html">{{ r.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      <div class="sidebar-card">
        <h4>Tags</h4>
        <div style="display:flex;flex-wrap:wrap;gap:4px">
          {% for tag in tool.tags %}
          <span class="tag-chip">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
    </aside>
  </div>
</div>

<!-- Footer -->
<footer>
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo"><span class="logo-icon">⚡</span><span>AI<span class="logo-accent">.</span>Nav</span></div>
        <p>A curated directory of 300+ open-source AI tools, agent frameworks, and skill libraries.</p>
      </div>
      <div class="footer-col">
        <h4>Categories</h4>
        <ul>
          <li><a href="../index.html#ai-tools">AI Tools</a></li>
          <li><a href="../index.html#skill">Skill Frameworks</a></li>
          <li><a href="../index.html#agent">AI Agents</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Site</h4>
        <ul>
          <li><a href="../about.html">About</a></li>
          <li><a href="../contact.html">Contact</a></li>
          <li><a href="../privacy-policy.html">Privacy Policy</a></li>
          <li><a href="../sitemap.xml">Sitemap</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Featured</h4>
        <ul>
          <li><a href="cursor.html">Cursor AI</a></li>
          <li><a href="claude-code.html">Claude Code</a></li>
          <li><a href="chatgpt.html">ChatGPT</a></li>
          <li><a href="ollama.html">Ollama</a></li>
          <li><a href="langchain.html">LangChain</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2025 AI Nav · All tools are open-source, hosted on GitHub.</p>
      <p>Built for the AI community ❤️</p>
    </div>
  </div>
</footer>

<script>
function faqToggle(el) { el.closest('.faq-item').classList.toggle('open'); }
</script>
</body>
</html>
